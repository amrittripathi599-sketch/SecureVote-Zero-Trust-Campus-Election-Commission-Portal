# SecureVote Backend Environment Variables
# Copy to .env for local overrides

ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./securevote.db

# Optional Azure Key Vault (Loads DATABASE_URL, JWT_SECRET, AZURE_STORAGE_CONNECTION_STRING via Managed Identity)
KEY_VAULT_URL=

# Authentication (Change in production to a 32+ character random secret)
JWT_SECRET=INSECURE_DEV_SECRET_CHANGE_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend CORS URL
FRONTEND_ORIGIN=http://localhost:5173

# Azure Blob Storage (Optional: leave blank to store uploads in local uploads/ directory)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=manifestos

# Local Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=10
